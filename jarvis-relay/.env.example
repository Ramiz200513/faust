# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env       (или вручную скопируй и переименуй в PowerShell)
# .env добавлен в .gitignore — секреты из него в репозиторий не попадают.
# docker-compose.yml сам подхватывает .env, лежащий рядом с ним.

# Секрет для админ-эндпоинтов релея (POST /api/pairing-codes, GET/DELETE
# /api/devices и т.п.). Пока релей смотрит только в localhost, можно
# оставить как есть; если он доступен из сети (телефон по Wi-Fi/Tailscale),
# смени на длинную случайную строку.
JARVIS_ADMIN_TOKEN=dev-admin-change-me

# Новый ПК подключается сам, без кода от администратора: агент дергает
# POST /api/agent/register и сразу гасит выданный код. Это и есть сценарий
# "скачал инсталлятор, нажал Подключить". По умолчанию выключено: включай,
# понимая, что зарегистрировать агента сможет любой, кто знает адрес релея
# (чужой ПК он при этом не получит — телефон привязывается QR-кодом с
# конкретной машины). Ограничение частоты по IP — JARVIS_OPEN_REGISTRATION_PER_HOUR.
JARVIS_OPEN_REGISTRATION=false

# Ключ Gemini для распознавания голосовых команд (natural language -> команда).
# Пусто -> релей молча использует простой regex-разбор (StubIntentParser).
JARVIS_LLM_API_KEY=

# Название модели Gemini. Меняй, если в AI Studio сменилось имя актуальной
# Flash-модели — дефолт в application.yml может отстать от поддерживаемых.
JARVIS_LLM_MODEL=gemini-3.6-flash

# Учётные данные PostgreSQL. Меняй ТОЛЬКО пока том jarvis-db-data ещё не
# создан (первый запуск) — на уже существующей базе Postgres пароль сам не
# переучивается.
JARVIS_DB_USER=jarvis
JARVIS_DB_PASSWORD=jarvis
