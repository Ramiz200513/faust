# Секреты «Фауста» на сервере. Скопируйте в .env рядом с docker-compose.prod.yml
# и заполните. .env в git не попадает (.gitignore).
#
# Случайные строки удобно получить так (на сервере, в Linux):
#   openssl rand -base64 36

# Домен сервера, который смотрит на IP вашего VPS (A-запись у регистратора
# или бесплатный поддомен, например на duckdns.org).
FAUST_DOMAIN=faust.example.kz

# Минимум 32 символа — иначе релей не запустится (StrongSecretsCheck).
JARVIS_ADMIN_TOKEN=

# Минимум 16 символов. Задаётся ДО первого запуска: на уже созданной базе
# Postgres пароль сам не поменяется.
JARVIS_DB_USER=jarvis
JARVIS_DB_PASSWORD=

# Ключ Gemini — только здесь, на сервере. На телефоне и ПК его нет.
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=gemini-3.6-flash

# auto — своя модель, при неуверенности Gemini; gemini — только Gemini
# (если на сервере не запущен сервис ollama, auto сам уйдёт к Gemini).
JARVIS_INTENT_ENGINE=auto

# Готовый образ релея из реестра. Пайплайн публикует его как
# ghcr.io/<владелец>/faust-relay:latest (имя владельца — строчными).
RELAY_IMAGE=ghcr.io/OWNER/faust-relay:latest

# Новый ПК подключается сам, без кода от администратора. Оставьте false.
JARVIS_OPEN_REGISTRATION=false
